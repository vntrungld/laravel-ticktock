{
    "name": "vntrungld/laravel-ticktock",
    "description": "Laravel TickTock - A hierarchical code execution timer for Laravel",
    "require": {
        "php": "~7.0|~8.0",
        "illuminate/support": "^5.5|^6|^7|^8|^9|^10|^11|^12"
    },
    "require-dev": {
        "mockery/mockery": "^1.0",
        "phpunit/phpunit": "^6.5|^7|^8|^9|^10|^11",
        "orchestra/testbench": "^3.5|^4|^5|^6|^7|^8|^9|^10"
    },
    "license": "MIT",
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
            "Vntrungld\\LaravelTicktock\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vntrungld\\LaravelTicktock\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vntrungld\\LaravelTicktock\\TickTockServiceProvider"
            ],
            "aliases": {
                "Ticktock": "Vntrungld\\LaravelTicktock\\Facades\\TickTock"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint",
        "lint:test": "pint --test"
    },
    "authors": [
        {
            "name": "Lam Duc Trung",
            "email": "vn.trungld@gmail.com"
        }
    ]
}
